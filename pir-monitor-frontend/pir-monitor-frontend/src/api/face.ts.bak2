import http from './index'

/** 人脸服务状态 */
export function getFaceStatusApi() {
  return http.get('/face/status')
}

/** 人脸注册 */
export function registerFaceApi(personId: string, imageFile: File, personName?: string, userId?: number) {
  const form = new FormData()
  form.append('personId', personId)
  form.append('image', imageFile)
  if (personName) form.append('name', personName)
  if (userId) form.append('userId', String(userId))
  return http.post('/face/register', form)
}

/** 获取已注册用户 */
export function getFaceUsersApi() {
  return http.get('/face/users')
}

/** 删除已注册用户 */
export function deleteFaceUserApi(name: string) {
  return http.delete(`/face/users/${encodeURIComponent(name)}`)
}

/** 获取识别记录 */
export function getFaceRecordsApi() {
  return http.get('/face/record/list')
}

/** 上传识别 */
export function identifyFaceApi(image: File, deviceCode: string, location: string) {
  const form = new FormData()
  form.append('image', image)
  form.append('deviceCode', deviceCode)
  form.append('location', location)
  return http.post('/face/identify', form)
}

/** 活体检测 (发送 blob) */
export function liveDetectApi(blob: Blob) {
  return http.post('/face/live/detect', blob, {
    headers: { 'Content-Type': 'image/jpeg' },
  })
}

/** TTS 合成 */
export function ttsSynthesizeApi(text: string, speed?: number) {
  return http.post('/face/tts/synthesize', { text, speed: speed ?? 1, sid: 0 })
}
