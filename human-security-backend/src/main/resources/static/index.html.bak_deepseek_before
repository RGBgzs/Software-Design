<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>智慧安防 AI 智能体控制台</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{overflow-x:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;background:linear-gradient(160deg,#edf2f9 0%,#dce8f7 40%,#e4edf8 70%,#eef3fa 100%);min-height:100vh;padding:18px;color:#1e293b}
.container{max-width:1440px;width:calc(100% - 16px);margin:0 auto}

/* ===== HEADER ===== */
.header{
  background:linear-gradient(135deg,#0f2b5c 0%,#143778 30%,#1a45a0 60%,#1d4ec4 100%);
  color:#fff;border-radius:16px 16px 0 0;padding:22px 32px 18px;
  text-align:center;position:relative;overflow:hidden
}
/* Tech grid overlay - pure CSS */
.header::before{
  content:'';position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
  background-size:40px 40px;background-position:center center;
  opacity:.6;pointer-events:none
}
.header::after{
  content:'';position:absolute;top:-60px;right:-60px;
  width:200px;height:200px;
  background:radial-gradient(circle,rgba(255,255,255,.06) 0%,transparent 70%);
  border-radius:50%
}
.header h1{
  font-size:23px;font-weight:800;letter-spacing:2.5px;
  margin-bottom:5px;position:relative;z-index:1;
  text-shadow:0 1px 3px rgba(0,0,0,.2)
}
.header .sub{
  font-size:12px;opacity:.82;letter-spacing:1.5px;
  position:relative;z-index:1
}

/* ===== TABS ===== */
.tabs{
  display:flex;flex-wrap:wrap;gap:5px;
  padding:10px 20px;
  background:linear-gradient(180deg,#132f6e,#0f2755);
  justify-content:center;position:relative
}
.tabs button{
  padding:7px 18px;border:1px solid rgba(255,255,255,.28);
  border-radius:20px;background:transparent;
  color:rgba(255,255,255,.82);font-size:12px;font-weight:500;
  cursor:pointer;transition:all .22s ease;white-space:nowrap;
  outline:none;line-height:1.4
}
.tabs button:hover{
  background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.45);color:#fff
}
.tabs button.active{
  background:#fff;color:#143778;border-color:#fff;
  font-weight:700;box-shadow:0 2px 10px rgba(0,0,0,.2)
}

/* ===== MAIN ===== */
.main{
  background:#fff;border-radius:0 0 16px 16px;
  box-shadow:0 4px 30px rgba(0,50,110,.07);min-height:80vh
}
.section{display:none;padding:24px 28px;width:100%;min-width:0;overflow:hidden}
.section.active{display:block}

/* ===== STATS CARDS ===== */
.stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}
.stat-card{
  background:#fff;border-radius:14px;padding:18px 12px 16px;
  text-align:center;border:1px solid #e8edf4;
  box-shadow:0 1px 3px rgba(0,0,0,.02);
  transition:transform .2s,box-shadow .2s, border-color .2s;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:110px
}
.stat-card:hover{
  transform:translateY(-2px);
  box-shadow:0 6px 20px rgba(0,50,120,.08);
  border-color:#d0d7e4
}
.stat-card .ic{font-size:24px;margin-bottom:6px;display:block;line-height:1}
.stat-card .n{font-size:34px;font-weight:800;color:#2563eb;line-height:1.1}
.stat-card .l{font-size:11px;color:#64748b;margin-top:5px;font-weight:600;letter-spacing:.3px}
.stat-card.warn{background:#fffbfb;border-color:#fecaca}
.stat-card.warn .n{color:#dc2626}
.stat-card.msg-unread{background:#fffbfb;border-color:#fecaca}
.stat-card.msg-unread .n{color:#dc2626}

/* ===== ALERT BOXES ===== */
.alert-box{
  border-radius:14px;padding:16px 22px;margin-bottom:16px;
  display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;
  border:1px solid #dcfce7;border-left:5px solid #16a34a;
  background:linear-gradient(135deg,#f0fdf4,#fafdf7)
}
.alert-box.red{
  border-color:#fecaca;border-left-color:#dc2626;
  background:linear-gradient(135deg,#fef5f5,#fefaf9)
}
.alert-box.blue{
  border-color:#bfdbfe;border-left-color:#2563eb;
  background:linear-gradient(135deg,#eff6ff,#f8fafe)
}
.alert-box .ai{font-size:26px;flex-shrink:0;line-height:1.2}
.alert-box .at{flex:1;font-size:13px;color:#334155;line-height:1.7;min-width:180px}
.alert-box.red .at{color:#991b1b}

/* ===== ENTRY CARDS ===== */
.entry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
.entry-card{
  background:#fff;border-radius:16px;padding:24px 20px;
  border:1px solid #e8edf4;box-shadow:0 2px 8px rgba(0,50,110,.03);
  transition:all .25s ease;cursor:pointer;
  position:relative;overflow:hidden
}
.entry-card::after{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,#2563eb,#60a5fa,#2563eb);
  opacity:0;transition:opacity .25s
}
.entry-card:hover{
  transform:translateY(-4px);
  box-shadow:0 10px 32px rgba(0,50,120,.1);
  border-color:#bdd3f0
}
.entry-card:hover::after{opacity:1}
.entry-card .ci{font-size:38px;margin-bottom:10px;display:block;line-height:1}
.entry-card h3{font-size:15px;font-weight:700;color:#1e293b;margin-bottom:5px}
.entry-card p{font-size:12px;color:#64748b;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}

/* ===== CHAT ===== */
.chat-box{
  height:50vh;overflow-y:auto;display:flex;flex-direction:column;gap:12px;
  background:linear-gradient(180deg,#fafbfd,#f5f7fb);
  border-radius:14px;padding:16px;margin-bottom:12px;border:1px solid #e8edf4
}
.chat-box::-webkit-scrollbar{width:5px}
.chat-box::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
.tbl-wrap::-webkit-scrollbar{height:5px}
.tbl-wrap::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
.chat-box::-webkit-scrollbar-track{background:transparent}
.msg{display:flex;flex-direction:column;max-width:85%;animation:fadeIn .3s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg.user{align-self:flex-end;align-items:flex-end}
.msg.user .b{
  background:linear-gradient(135deg,#2563eb,#3b82f6);
  color:#fff;padding:11px 17px;border-radius:20px 20px 4px 20px;
  font-size:14px;line-height:1.6;word-break:break-word;
  box-shadow:0 3px 10px rgba(37,99,235,.2)
}
.msg.bot{align-self:flex-start;align-items:flex-start}
.msg.bot .b{
  background:#fff;color:#334155;padding:11px 17px;
  border-radius:20px 20px 20px 4px;font-size:14px;line-height:1.7;
  word-break:break-word;white-space:pre-line;
  box-shadow:0 1px 4px rgba(0,0,0,.04);border:1px solid #eef2f7
}
.msg.bot .m{font-size:10px;color:#94a3b8;margin-top:4px;margin-left:8px}
.msg .lbl{font-size:10px;color:#94a3b8;margin-bottom:3px;margin-left:8px;font-weight:500}
.msg.user .lbl{margin-right:8px;margin-left:0;text-align:right}
.typing{display:flex;gap:4px;padding:12px 17px}
.typing span{width:7px;height:7px;background:#94a3b8;border-radius:50%;animation:bounce 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.quick-row{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:10px}
.quick-btn{
  background:#eff6ff;color:#2563eb;border:1.5px solid #bfdbfe;
  padding:6px 14px;border-radius:18px;font-size:11px;font-weight:600;
  cursor:pointer;transition:all .2s;white-space:nowrap
}
.quick-btn:hover{background:#2563eb;color:#fff;border-color:#2563eb;box-shadow:0 3px 10px rgba(37,99,235,.25)}
.chat-input-row{display:flex;gap:8px;align-items:center}
.chat-input-row input{
  flex:1;padding:11px 15px;border:1.5px solid #e2e8f0;
  border-radius:22px;font-size:13px;outline:0;min-width:0;
  transition:all .2s;background:#f8fafc
}
.chat-input-row input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1);background:#fff}
.voice-row{display:flex;align-items:center;gap:10px;margin-top:8px;flex-wrap:wrap;font-size:11px;color:#94a3b8}
.voice-row .vs{flex:1;min-width:100px;color:#64748b}
.tgl{display:inline-flex;align-items:center;gap:4px;cursor:pointer;user-select:none;white-space:nowrap;font-size:11px;color:#64748b}
.tgl input{cursor:pointer;margin:0;accent-color:#2563eb}

/* ===== TOOLBAR ===== */
.toolbar{display:flex;justify-content:space-between;align-items:center;padding:0 0 14px;flex-wrap:wrap;gap:10px;max-width:100%}
.fg{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.fg select,.fg input{
  padding:7px 12px;border:1.5px solid #e2e8f0;border-radius:16px;
  font-size:12px;outline:0;background:#fff;transition:border-color .2s
}
.fg select:focus,.fg input:focus{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,.08)}
.fg input{width:200px}

/* ===== TABLES ===== */
.tbl-wrap{overflow-x:auto;border-radius:14px;border:1px solid #e5e7eb;background:#fff}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:700px;table-layout:auto}
thead th{
  background:#f6f8fc;color:#475569;font-weight:700;
  padding:10px 10px;text-align:left;
  border-bottom:2px solid #e2e8f0;white-space:nowrap;
  font-size:11px;letter-spacing:.4px
}
tbody td{
  padding:9px 10px;border-bottom:1px solid #f1f5f9;
  vertical-align:middle;line-height:1.5;color:#334155
}
tbody tr{transition:background .1s}
tbody tr:nth-child(even){background:#fafbfd}
tbody tr:hover{background:#f0f4fa}
tbody tr.high-row{background:#fef5f5 !important;border-left:3px solid #dc2626}
.ellipsis{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.empty td{text-align:center;color:#94a3b8;padding:40px 20px;font-size:13px}

/* ===== BADGES ===== */
.badge{display:inline-block;padding:3px 10px;border-radius:10px;font-size:10px;font-weight:600;white-space:nowrap;letter-spacing:.3px;line-height:1.5;vertical-align:middle}
.bg-green{background:#dcfce7;color:#166534}
.bg-red{background:#fecaca;color:#991b1b}
.bg-orange{background:#ffedd5;color:#9a3412}
.bg-blue{background:#dbeafe;color:#1e40af}
.bg-gray{background:#f1f5f9;color:#475569}
.bg-purple{background:#ede9fe;color:#5b21b6}

/* ===== BUTTONS ===== */
.btn{
  padding:8px 18px;border:none;border-radius:20px;
  font-size:12px;font-weight:600;cursor:pointer;
  transition:all .2s ease;white-space:nowrap;
  text-decoration:none;display:inline-block;line-height:1.35
}
.btn:active{transform:scale(.96)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none !important}
.btn-p{background:#2563eb;color:#fff;box-shadow:0 2px 6px rgba(37,99,235,.25)}
.btn-p:hover:not(:disabled){background:#1d4ed8;box-shadow:0 4px 14px rgba(37,99,235,.35)}
.btn-o{background:#fff;color:#2563eb;border:1.5px solid #2563eb}
.btn-o:hover:not(:disabled){background:#eff6ff;border-color:#1d4ed8}
.btn-s{background:#16a34a;color:#fff;box-shadow:0 2px 6px rgba(22,163,74,.2)}
.btn-s:hover:not(:disabled){background:#15803d;box-shadow:0 4px 12px rgba(22,163,74,.3)}
.btn-d{background:#dc2626;color:#fff;box-shadow:0 2px 6px rgba(220,38,38,.2)}
.btn-d:hover:not(:disabled){background:#b91c1c;box-shadow:0 4px 12px rgba(220,38,38,.3)}
.btn-w{background:#f97316;color:#fff;box-shadow:0 2px 6px rgba(249,115,22,.2)}
.btn-w:hover:not(:disabled){background:#ea580c;box-shadow:0 4px 12px rgba(249,115,22,.3)}
.btn-xs{padding:5px 12px;font-size:11px;border-radius:14px}
.ico-btn{
  width:36px;height:36px;border-radius:50%;border:1.5px solid #e2e8f0;
  background:#fff;color:#2563eb;font-size:16px;cursor:pointer;
  transition:all .2s;display:inline-flex;align-items:center;
  justify-content:center;flex-shrink:0
}
.ico-btn:hover:not(:disabled){background:#eff6ff;border-color:#2563eb}
.ico-btn:active{transform:scale(.93)}
.ico-btn:disabled{background:#f8fafc;color:#cbd5e1;border-color:#e2e8f0;cursor:not-allowed}
.ico-btn.lst{background:#dc2626;color:#fff;border-color:#dc2626;animation:pulse-bg 1.5s infinite}
.send-btn{
  background:#2563eb;color:#fff;border:none;width:36px;height:36px;
  border-radius:50%;font-size:16px;cursor:pointer;transition:all .2s;
  display:inline-flex;align-items:center;justify-content:center;
  flex-shrink:0;box-shadow:0 2px 6px rgba(37,99,235,.3)
}
.send-btn:hover:not(:disabled){background:#1d4ed8;box-shadow:0 4px 12px rgba(37,99,235,.4)}
.send-btn:disabled{background:#93c5fd;cursor:not-allowed;box-shadow:none}
@keyframes pulse-bg{0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,.4)}50%{box-shadow:0 0 0 8px rgba(220,38,38,0)}}
.pagi{text-align:center;padding:14px;font-size:12px;color:#64748b;font-weight:500}

/* ===== MODAL ===== */
.modal-over{
  display:none;position:fixed;top:0;left:0;right:0;bottom:0;
  background:rgba(15,23,42,.45);z-index:100;
  justify-content:center;align-items:flex-start;
  padding-top:44px;backdrop-filter:blur(2px)
}
.modal-over.active{display:flex}
.modal{
  background:#fff;border-radius:18px;width:92%;max-width:620px;
  max-height:84vh;overflow-y:auto;
  box-shadow:0 20px 60px rgba(0,0,0,.18);
  padding:24px 28px;
  animation:modalIn .2s ease
}
@keyframes modalIn{from{opacity:0;transform:translateY(-12px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal h2{
  font-size:17px;font-weight:700;color:#1e293b;
  margin-bottom:18px;padding-bottom:14px;
  border-bottom:2px solid #f1f5f9
}
.modal::-webkit-scrollbar{width:4px}
.modal::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}
.fg2{margin-bottom:15px}
.fg2 label{display:block;font-size:12px;color:#475569;font-weight:600;margin-bottom:5px}
.fg2 input,.fg2 textarea,.fg2 select{
  width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;
  border-radius:10px;font-size:13px;font-family:inherit;
  outline:0;transition:all .2s;background:#f8fafc
}
.fg2 textarea{resize:vertical;min-height:85px}
.fg2 input:focus,.fg2 textarea:focus,.fg2 select:focus{
  border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.08);background:#fff
}
.detail-row{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px}
.di{margin-bottom:14px}
.di .dl{
  font-size:11px;color:#94a3b8;margin-bottom:3px;
  font-weight:600;letter-spacing:.4px
}
.di .dv{font-size:13px;color:#1e293b;word-break:break-word;line-height:1.55}
.di .dv-blk{
  background:#f8fafc;padding:14px 16px;border-radius:10px;
  line-height:1.7;white-space:pre-line;border:1px solid #eef2f7;
  color:#334155;font-size:13px;max-height:300px;overflow-y:auto
}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:36px;left:50%;transform:translateX(-50%);
  padding:10px 24px;border-radius:24px;font-size:13px;font-weight:600;
  z-index:200;opacity:0;transition:opacity .3s ease;
  pointer-events:none;white-space:nowrap;box-shadow:0 4px 18px rgba(0,0,0,.1)
}
.toast.show{opacity:1}
.toast-ok{background:#dcfce7;color:#166534}
.toast-err{background:#fecaca;color:#991b1b}
.toast-info{background:#dbeafe;color:#1e40af}

/* ===== MESSAGE CENTER ===== */
.msg-tab-btn{
  padding:8px 22px;border-radius:20px;font-size:12px;font-weight:600;
  cursor:pointer;transition:all .2s;border:1.5px solid #e2e8f0;
  background:#fff;color:#64748b
}
.msg-tab-btn.active-tab{background:#2563eb;color:#fff;border-color:#2563eb;box-shadow:0 2px 8px rgba(37,99,235,.25)}
.msg-tab-btn:hover:not(.active-tab){background:#f8fafc;border-color:#cbd5e1;color:#475569}
.msg-user-bar{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:14px 18px;background:#f8fafc;border-radius:14px;
  margin-bottom:16px;border:1px solid #e8edf4
}
.msg-user-bar label{font-size:12px;font-weight:700;color:#475569;white-space:nowrap}
.msg-user-bar select{
  padding:7px 14px;border:1.5px solid #e2e8f0;border-radius:18px;
  font-size:12px;outline:none;background:#fff;min-width:140px;
  transition:border-color .2s
}
.msg-user-bar select:focus{border-color:#2563eb}
.msg-unread-count{
  font-size:12px;font-weight:700;color:#dc2626;
  background:#fef2f2;padding:3px 12px;border-radius:12px;
  border:1px solid #fecaca
}


/* ===== MESSAGE CENTER LAYOUT ===== */
.message-layout{display:grid;grid-template-columns:380px minmax(0,1fr);gap:20px;align-items:start}
.msg-left-panel{display:flex;flex-direction:column;gap:14px}
.msg-right-panel{min-width:0;overflow:hidden}
.msg-right-panel .tbl-wrap{overflow-x:auto;max-width:100%}
@media(max-width:1000px){
  .message-layout{grid-template-columns:1fr}
  .msg-left-panel{order:1}
  .msg-right-panel{order:2}
}

/* ===== HELP LAYOUT FIX ===== */


/* ===== HISTORY TABLE FIX ===== */
.history-table-wrap{overflow-x:auto;max-width:100%}
.history-table-wrap table{min-width:780px}


/* ===== HELP SECTION ===== */
.help-contact-card{
  background:#fff;border-radius:14px;padding:16px;
  border:1px solid #e8edf4;margin-bottom:14px;
  transition:box-shadow .2s
}
.help-contact-card:hover{box-shadow:0 3px 14px rgba(0,0,0,.06)}
.help-preview-box{background:#f8fafc;border-radius:14px;padding:18px;border:1px solid #e8edf4;min-height:240px}
.help-preview-box textarea{
  font-family:"SF Mono","Consolas","Menlo",monospace;
  font-size:12px;background:#fff;line-height:1.7;
  color:#334155;border-color:#e2e8f0
}

/* ===== SEND FORM ===== */
.send-form-card{
  background:#f8fafc;border-radius:14px;padding:22px;
  border:1px solid #e8edf4;max-width:520px
}
.send-form-card .fg2:last-child{margin-bottom:0}
.send-form-card .btn-p{margin-top:4px}

/* ===== PAGE HEADER ===== */
.page-title-row{
  display:flex;align-items:center;gap:10px;margin-bottom:16px;
  padding-bottom:12px;border-bottom:2px solid #f1f5f9
}
.page-title-row .pt-icon{font-size:20px;flex-shrink:0}
.page-title-row .pt-text{font-size:16px;font-weight:700;color:#1e293b}


/* ===== HELP 3-COLUMN LAYOUT ===== */
.help-layout{display:grid;grid-template-columns:320px 360px minmax(420px,1fr);gap:20px;align-items:start;width:100%}
.help-contacts-panel,.help-form-panel,.help-preview-panel{min-width:0;width:100%}
#contactList{line-height:1.6}
#contactList>div{padding:10px 0;border-bottom:1px solid #f1f5f9}
#contactList>div:last-child{border-bottom:none}
@media(max-width:1280px){
  .help-layout{grid-template-columns:300px 320px minmax(340px,1fr);gap:16px}
}
@media(max-width:1080px){
  .help-layout{grid-template-columns:280px minmax(300px,1fr)}
  .help-preview-panel{grid-column:1/-1}
}

/* Mobile 900px breakpoint */

@media(max-width:1200px){.home-entry-grid{grid-template-columns:repeat(3, minmax(160px, 1fr))}}
@media(max-width:900px){
  .app-shell{display:block;width:100%}
  .side-nav{border-radius:0}
  .side-nav .nav-title{display:none}
  .side-nav .tabs{flex-direction:row;flex-wrap:wrap;gap:4px;padding:8px 10px;justify-content:center}
  .side-nav .tabs button{display:inline-block;width:auto;text-align:center;padding:6px 12px;font-size:11px;border-radius:18px}
  .side-nav .tabs button.active{background:#fff;color:#143778;border-color:#fff}
  .main-panel{border-radius:0;overflow-x:hidden}
  .main-panel .main{border-radius:0 0 12px 12px}
  .section{padding:18px 14px}
  .stats-row{grid-template-columns:repeat(2,1fr);gap:8px}
  .dashboard-grid{grid-template-columns:1fr}
  .two-col,.two-col-70-30,.two-col-35-65,.two-col-40-60{grid-template-columns:1fr}
