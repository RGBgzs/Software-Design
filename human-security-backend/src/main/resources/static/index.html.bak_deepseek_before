if(!("speechSynthesis" in window)){$("speakBtn").disabled=true;$("autoSpeak").disabled=true}
if(!SpeechRecognition){$("voiceBtn").disabled=true;$("voiceStatus").textContent="⚠️ 浏览器不支持语音识别"}
if(SpeechRecognition){rec=new SpeechRecognition();rec.lang="zh-CN";rec.interimResults=false;rec.continuous=false;rec.maxAlternatives=1;
rec.onstart=function(){listening=true;$("voiceBtn").classList.add("lst");$("stopBtn").disabled=false;$("voiceStatus").textContent="正在听，请说话……"};
rec.onresult=function(e){var t="";for(var i=e.resultIndex;i<e.results.length;i++)t+=e.results[i][0].transcript;t=t.trim();if(t){$("voiceStatus").textContent="识别："+t;sendMsg(t)}else{$("voiceStatus").textContent="未识别到有效语音"}};
rec.onerror=function(e){if(e.error==="not-allowed")$("voiceStatus").textContent="⚠️ 麦克风权限被拒绝";else if(e.error==="no-speech")$("voiceStatus").textContent="未检测到语音";else if(e.error!=="aborted")$("voiceStatus").textContent="出错:"+e.error;resetVoice()};
rec.onend=function(){resetVoice()}}
function resetVoice(){listening=false;$("voiceBtn").classList.remove("lst");$("stopBtn").disabled=true;$("voiceStatus").textContent="语音就绪"}
function startVoice(){if(!rec){toast("浏览器不支持语音识别，请使用 Chrome 或 Edge","err");return}if(listening)return;if("speechSynthesis" in window)speechSynthesis.cancel();try{rec.start()}catch(e){$("voiceStatus").textContent="启动失败";resetVoice()}}
function stopVoice(){if(rec&&listening){rec.abort();resetVoice()}if("speechSynthesis" in window)speechSynthesis.cancel()}

function stripSpeech(t){if(!t)return"";var d=document.createElement("div");d.innerHTML=t;var p=d.textContent||"";p=p.replace(/[\u{1F000}-\u{1FFFF}\u{2600}-\u{27BF}\u{FE00}-\u{FE0F}\u{200D}]/gu,"");p=p.replace(/\n{3,}/g,"\n\n").replace(/[ ]{2,}/g," ");return p.trim()}
function doSpeak(t){if(!("speechSynthesis" in window)||!t)return;speechSynthesis.cancel();var c=stripSpeech(t);if(!c)return;var u=new SpeechSynthesisUtterance(c);u.lang="zh-CN";u.rate=1;u.pitch=1;speechSynthesis.speak(u)}
function speakLast(){if(lastAnswer){if(rec&&listening){rec.abort();resetVoice()}doSpeak(lastAnswer);$("voiceStatus").textContent="正在播报……"}else{$("voiceStatus").textContent="暂无回答"}}

function pollAlarm(){fetch(API+"/alarm/latest").then(function(r){return r.json()}).then(function(d){if(d.hasAlarm&&d.data&&d.data.id!==lastAlarmId){lastAlarmId=d.data.id;var t=d.speechText||"";if(t&&("speechSynthesis" in window)){speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t);u.lang="zh-CN";u.rate=1;u.pitch=1;speechSynthesis.speak(u);$("voiceStatus").textContent="🔔 自动告警播报"}}if(!d.hasAlarm)lastAlarmId=null}).catch(function(){})}
$("alarmPoll").addEventListener("change",function(){if(this.checked){pollAlarm();alarmTimer=setInterval(pollAlarm,10000);toast("已开启告警自动播报","info")}else{if(alarmTimer)clearInterval(alarmTimer);alarmTimer=null;lastAlarmId=null;toast("已关闭告警自动播报","info")}});
