function generateHelpMsg(){var d=$("helpDevice").value.trim()||"未指定",l=$("helpLocation").value.trim()||"未指定",c=$("helpContent").value.trim()||"未指定",lv=$("helpLevel").value||"HIGH",t=new Date().toLocaleString("zh-CN");var msg="【智慧安防求助提醒】\n检测到异常安防事件，请及时关注。\n\n设备名称："+d+"\n设备位置："+l+"\n告警等级："+lv+"\n异常内容："+c+"\n发生时间："+t+"\n\n建议：\n请尽快确认现场情况。如无法及时处理，可联系家属、小区保安或物业人员协助查看。";$("helpPreview").value=msg;toast("求助信息已生成","ok")}
function generateFromAlarm(){fetch(API+"/alarm/latest").then(function(r){return r.json()}).then(function(d){if(d&&d.hasAlarm&&d.data){var a=d.data;$("helpDevice").value=a.deviceName||"";$("helpLocation").value=a.location||"";$("helpContent").value=a.alarmContent||"";$("helpLevel").value=a.alarmLevel||"HIGH";generateHelpMsg();toast("已根据最新告警生成求助信息","ok")}else{toast("暂无可用告警记录","err")}}).catch(function(){toast("获取告警失败","err")})}
function copyHelpMsg(){var t=$("helpPreview").value;if(!t||t.indexOf("点击生成")===0){toast("请先生成求助信息","err");return}if(navigator.clipboard){navigator.clipboard.writeText(t).then(function(){toast("已复制，可粘贴到短信或微信发送","ok")}).catch(function(){toast("复制失败，请手动复制","err")})}else{$("helpPreview").select();document.execCommand("copy");toast("已复制","ok")}}
function generateHelpFromAlarm(a){$("helpDevice").value=a.deviceName||a.device_name||"";$("helpLocation").value=a.location||"";$("helpContent").value=a.alarmContent||a.alarm_content||"";$("helpLevel").value=(a.alarmLevel||a.alarm_level||"HIGH").toUpperCase();generateHelpMsg();closeModal("detailModal");showSection("help");toast("已根据告警生成求助信息","ok")}
["kbModal","detailModal","contactModal"].forEach(function(id){$(id).addEventListener("click",function(e){if(e.target===this)closeModal(id)})});

// ==================== INIT ====================
initPage();

// ==================== AI RISK JUDGE ====================
function runAiJudge(){
  var btn = $("aiJudgeBtn");
  btn.disabled = true; btn.textContent = "研判中...";
  var resultDiv = $("aiJudgeResult");
  resultDiv.innerHTML = '<p style="color:#94a3b8;font-size:13px;padding:12px 0">⏳ AI 正在分析当前安防状态...</p>';

  fetch(API + "/ai/judge", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({userId: msgCurrentUserId || 1})
  }).then(function(r){ return r.json(); }).then(function(d){
    if(d.code === 200 && d.data){
      renderAiJudgeResult(d.data, "aiJudgeResult");
    } else {
      resultDiv.innerHTML = '<p style="color:#dc2626;font-size:13px;padding:12px 0">AI 研判失败，请稍后重试</p>';
    }
  }).catch(function(){
    resultDiv.innerHTML = '<p style="color:#dc2626;font-size:13px;padding:12px 0">AI 研判失败，请稍后重试</p>';
  }).finally(function(){
    btn.disabled = false; btn.textContent = "🔍 立即研判";
  });
}

function renderAiJudgeResult(data, targetId){
  var levels = {LOW:"#16a34a", MEDIUM:"#f97316", HIGH:"#dc2626", CRITICAL:"#991b1b"};
  var bgColors = {LOW:"#f0fdf4", MEDIUM:"#fff7ed", HIGH:"#fef2f2", CRITICAL:"#fef2f2"};
  var levelNames = {LOW:"低风险", MEDIUM:"中风险", HIGH:"高风险", CRITICAL:"严重风险"};
  var rl = data.riskLevel || "MEDIUM";
  var color = levels[rl] || "#64748b";
  var bg = bgColors[rl] || "#f8fafc";
  var levelName = levelNames[rl] || rl;

  var h = '<div style="border:2px solid ' + color + ';border-radius:14px;padding:18px;background:' + bg + '">';
  h += '<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px">';
  h += '<span style="font-size:28px">🤖</span>';
  h += '<span style="font-size:18px;font-weight:800;color:' + color + '">风险等级：' + levelName + '</span>';
  h += '<span class="badge" style="background:' + color + ';color:#fff;font-size:11px">' + rl + '</span>';
  if(data.source){ h += '<span class="badge bg-gray" style="font-size:10px">来源：' + esc(data.source) + '</span>'; }
  h += '</div>';
  h += '<div style="margin-bottom:10px"><strong style="color:#1e293b">📋 摘要：</strong><span style="color:#334155">' + esc(data.summary || "") + '</span></div>';
  h += '<div style="margin-bottom:10px"><strong style="color:#1e293b">📝 原因：</strong><span style="color:#475569;font-size:12px">' + esc(data.reason || "") + '</span></div>';
  if(data.suggestions && data.suggestions.length > 0){
    h += '<div style="margin-top:12px"><strong style="color:#1e293b">💡 建议操作：</strong></div>';
    h += '<ul style="margin:6px 0 0 18px;color:#475569;font-size:12px;line-height:1.8">';
    for(var i = 0; i < data.suggestions.length; i++){
      h += '<li>' + esc(data.suggestions[i]) + '</li>';
    }
    h += '</ul>';
  }
  if(data.needHumanConfirm){
    h += '<div style="margin-top:14px;padding:10px 14px;background:#fff;border-radius:10px;border:1px solid #fecaca;color:#991b1b;font-size:12px;font-weight:600">⚠️ 此风险需要人工确认，请勿直接忽略</div>';
  }
  // Action buttons
  if(rl !== 'LOW'){
    h += '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">';
    h += '<button class="btn btn-d btn-xs" onclick="showSection(\'alarm\')">🚨 查看告警</button>';
    h += '<button class="btn btn-w btn-xs" onclick="showSection(\'help\')">🆘 紧急求助</button>';
    h += '<button class="btn btn-o btn-xs" onclick="showSection(\'message\')">📬 消息中心</button>';
    h += '</div>';
  }
  h += '</div>';
  document.getElementById(targetId).innerHTML = h;
}

function analyzeAlarmWithAi(alarmId){
  var ab = $("detAiBtn");
  if(ab){ ab.disabled = true; ab.textContent = "分析中..."; }

  fetch(API + "/ai/judge", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({alarmId: alarmId})
  }).then(function(r){ return r.json(); }).then(function(d){
    if(d.code === 200 && d.data){
      showAiAlarmResult(d.data);
    }
  }).catch(function(){
    toast("AI 分析失败", "err");
  }).finally(function(){
    if(ab){ ab.disabled = false; ab.textContent = "🤖 AI 分析此告警"; }
  });
}

function showAiAlarmResult(data){
  var rl = data.riskLevel || "MEDIUM";
  var levels = {LOW:"#16a34a", MEDIUM:"#f97316", HIGH:"#dc2626", CRITICAL:"#991b1b"};
  var color = levels[rl] || "#64748b";
  var levelNames = {LOW:"低风险", MEDIUM:"中风险", HIGH:"高风险", CRITICAL:"严重风险"};

  var h = '<div style="margin-top:16px;border:2px solid ' + color + ';border-radius:12px;padding:16px;background:#fff">';
  h += '<div style="font-weight:700;color:#1e293b;margin-bottom:10px">🤖 AI 分析结果</div>';
  h += '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px">';
  h += '<span class="badge" style="background:' + color + ';color:#fff">' + (levelNames[rl] || rl) + '</span>';
  h += '<span style="font-size:13px;font-weight:600;color:#1e293b">' + esc(data.summary || "") + '</span>';
  h += '</div>';
  h += '<div style="font-size:12px;color:#475569;margin-bottom:8px">' + esc(data.reason || "") + '</div>';
  if(data.suggestions && data.suggestions.length > 0){
    h += '<ul style="margin:4px 0 0 16px;color:#475569;font-size:11px;line-height:1.7">';
    for(var i = 0; i < data.suggestions.length; i++){
      h += '<li>' + esc(data.suggestions[i]) + '</li>';
    }
    h += '</ul>';
  }
  // Quick actions
  h += '<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">';
  h += '<button class="btn btn-w btn-xs" onclick="if(window._detAlarm)generateHelpFromAlarm(window._detAlarm)">🆘 生成求助</button>';
  h += '<button class="btn btn-o btn-xs" onclick="if(window._detAlarm){var a=window._detAlarm;closeModal(\'detailModal\');var c=a.alarmContent||\'\';openMsgWithContent(\'智慧安防告警提醒\',\'设备：\'+esc(a.deviceName||a.device_name||\'-\')+\'\\n位置：\'+esc(a.location||\'-\')+\'\\n内容：\'+esc(c||\'-\')+\'\\n等级：\'+esc(a.alarmLevel||\'-\')+\'\\n时间：\'+ft(a.alarmTime||\'\'),\'ALARM\')}">📬 发送消息</button>';
  h += '</div>';
  h += '</div>';

  var contentDiv = $("detContent");
  if(contentDiv){
    contentDiv.innerHTML += h;
    // Scroll modal to bottom to show the AI result
    var modal = document.querySelector("#detailModal .modal");
    if(modal){ modal.scrollTop = modal.scrollHeight; }
  }
}
</script>
