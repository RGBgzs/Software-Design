function showMsgTab(tab) {
  msgCurrentBox = tab;
  $("msgInboxPanel").style.display = tab === "inbox" ? "block" : "none";
  $("msgOutboxPanel").style.display = tab === "outbox" ? "block" : "none";
  $("msgSendPanel").style.display = tab === "send" ? "block" : "none";
  var btns = document.querySelectorAll("#msgTabInbox,#msgTabOutbox,#msgTabSend");
  for (var i = 0; i < btns.length; i++) {
    btns[i].style.background = "#fff";
    btns[i].style.color = "#1a73e8";
    btns[i].style.border = "1px solid #1a73e8";
  }
  if (tab === "inbox") { btns[0].style.background = "#1a73e8"; btns[0].style.color = "#fff"; }
  if (tab === "outbox") { btns[1].style.background = "#1a73e8"; btns[1].style.color = "#fff"; }
  if (tab === "send") { btns[2].style.background = "#1a73e8"; btns[2].style.color = "#fff"; }
  // Disable status filter for outbox/send since only inbox has read/unread status
  var sf = $("msgStatusFilter");
  if (sf) { sf.disabled = (tab === "outbox" || tab === "send"); }
  if (tab === "inbox") loadInbox();
  if (tab === "outbox") loadOutbox();
}

function filterMsg(list) {
  var sw = ($("msgSearch") ? $("msgSearch").value : "").trim().toLowerCase();
  var sf = ($("msgStatusFilter") ? $("msgStatusFilter").value : "");
  var tf = ($("msgTypeFilter") ? $("msgTypeFilter").value : "");
  return list.filter(function(m) {
    if (sw) {
      var hay = (m.title || "") + " " + (m.content || "") + " " + getMsgSenderName(m) + " " + getMsgReceiverName(m);
      if (hay.toLowerCase().indexOf(sw) === -1) return false;
    }
    // Status filter applies to inbox only
    if (msgCurrentBox === "inbox") {
      var rs = getMsgReadStatus(m);
      if (sf === "unread" && rs !== 0) return false;
      if (sf === "read" && rs !== 1) return false;
    }
    if (tf && getMsgType(m) !== tf) return false;
    return true;
  });
}

function loadInbox() {
  if (!msgCurrentUserId) return;
  fetch(API + "/messages/inbox?userId=" + msgCurrentUserId).then(function(r) { return r.json(); }).then(function(d) {
    msgInboxList = d.data || [];
    var list = filterMsg(msgInboxList);
    if (!list.length) {
      $("msgInboxTbody").innerHTML = '<tr class="empty"><td colspan="6">' + (msgInboxList.length ? "暂无匹配消息" : "暂无收到的消息") + '</td></tr>';
      loadUnreadCount();
      return;
    }
    var h = "";
    for (var i = 0; i < list.length; i++) {
      var m = list[i];
      var rs = getMsgReadStatus(m);
      var sb = rs === 1 ? '<span class="badge bg-green">已读</span>' : '<span class="badge bg-red">未读</span>';
      var rstyle = rs === 0 ? ' style="font-weight:600"' : "";
      var mt=getMsgType(m);var mtBadge=mt==='ALARM'?'<span class="badge bg-red">ALARM</span>':mt==='HELP'?'<span class="badge bg-orange">HELP</span>':'<span class="badge bg-blue">NORMAL</span>';h += '<tr' + rstyle + '><td>' + sb + '</td><td>' + esc(getMsgSenderName(m)) + '</td><td>' + esc(m.title || '') + ' ' + mtBadge + '</td><td><div class="ellipsis">' + esc(m.content || '') + '</div></td><td style="white-space:nowrap">' + ft(getMsgTime(m)) + '</td><td><button class="btn btn-o btn-xs" onclick="showMsgDetail(' + m.id + ')">详情</button>' + (rs !== 1 ? ' <button class="btn btn-xs btn-s" onclick="markMsgRead(' + m.id + ')">已读</button>' : '') + ' <button class="btn btn-d btn-xs" onclick="deleteMsg(' + m.id + ')">删除</button></td></tr>';
    }
    $("msgInboxTbody").innerHTML = h;
    loadUnreadCount();
  }).catch(function() { $("msgInboxTbody").innerHTML = '<tr class="empty"><td colspan="6">收件箱加载失败</td></tr>'; });
}

function loadOutbox() {
  if (!msgCurrentUserId) return;
  fetch(API + "/messages/outbox?userId=" + msgCurrentUserId).then(function(r) { return r.json(); }).then(function(d) {
    msgOutboxList = d.data || [];
    var list = filterMsg(msgOutboxList);
    if (!list.length) {
      $("msgOutboxTbody").innerHTML = '<tr class="empty"><td colspan="5">' + (msgOutboxList.length ? "暂无匹配消息" : "暂无发出的消息") + '</td></tr>';
      return;
    }
    var h = "";
    for (var i = 0; i < list.length; i++) {
      var m = list[i];
      var mt2=getMsgType(m);var mtBadge2=mt2==='ALARM'?'<span class="badge bg-red">ALARM</span>':mt2==='HELP'?'<span class="badge bg-orange">HELP</span>':'<span class="badge bg-blue">NORMAL</span>';h += '<tr><td>' + esc(getMsgReceiverName(m)) + '</td><td>' + esc(m.title || '') + ' ' + mtBadge2 + '</td><td><div class="ellipsis">' + esc(m.content || '') + '</div></td><td style="white-space:nowrap">' + ft(getMsgTime(m)) + '</td><td><button class="btn btn-o btn-xs" onclick="showMsgDetail(' + m.id + ')">详情</button> <button class="btn btn-d btn-xs" onclick="deleteMsg(' + m.id + ')">删除</button></td></tr>';
    }
    $("msgOutboxTbody").innerHTML = h;
  }).catch(function() { $("msgOutboxTbody").innerHTML = '<tr class="empty"><td colspan="5">发件箱加载失败</td></tr>'; });
}

function sendMessageMsg() {
  if (msgSending) return;
  if (!msgCurrentUserId) { toast("请先选择当前用户", "err"); return; }
  var rid = $("msgReceiver").value;
  if (!rid || rid === "") { toast("请选择接收人", "err"); return; }
  if (parseInt(rid) === msgCurrentUserId) { toast("不能给自己发送消息", "err"); return; }
  var title = ($("msgTitle").value || "").trim();
  var content = ($("msgContent").value || "").trim();
  if (!title) { toast("标题不能为空", "err"); return; }
  if (!content) { toast("内容不能为空", "err"); return; }
  if (title.length > 100) { toast("标题不能超过100字", "err"); return; }

  msgSending = true;
  var btn = document.querySelector("#msgSendPanel .btn-p");
  btn.disabled = true;
  btn.textContent = "发送中...";

  var msgType = window._msgType || "NORMAL";

  fetch(API + "/messages/send", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      senderId: msgCurrentUserId,
      receiverId: parseInt(rid),
      title: title,
      content: content,
      messageType: msgType
    })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.code === 200) {
      toast("消息发送成功", "ok");
      $("msgTitle").value = "";
      $("msgContent").value = "";
      window._msgType = null;
      loadOutbox();
      loadUnreadCount();
      refreshHomeUnread();
      if (msgCurrentBox === "outbox") loadOutbox();
    } else {
      toast(d.message || "发送失败", "err");
    }
  }).catch(function() {
    toast("消息发送失败，请稍后重试", "err");
  }).finally(function() {
    msgSending = false;
    btn.disabled = false;
    btn.textContent = "📨 发送";
  });
}

function markMsgRead(id) {
  fetch(API + "/messages/" + id + "/read", { method: "POST" }).then(function(r) { return r.json(); }).then(function(d) {
    loadInbox();
    loadUnreadCount();
    refreshHomeUnread();
  }).catch(function() { toast("操作失败", "err"); });
}

function deleteMsg(id) {
  if (!confirm("确定删除这条消息吗？")) return;
  fetch(API + "/messages/" + id + "/delete?userId=" + msgCurrentUserId, { method: "POST" }).then(function(r) { return r.json(); }).then(function(d) {
    toast("已删除", "ok");
    if (msgCurrentBox === "inbox") loadInbox();
    else loadOutbox();
    loadUnreadCount();
    refreshHomeUnread();
  }).catch(function() { toast("删除失败", "err"); });
}

function showMsgDetail(id) {
  function found(list) {
    for (var i = 0; i < list.length; i++) { if (list[i].id == id) return list[i]; }
    return null;
  }
  // Check cached lists first
  var m = found(msgInboxList);
  if (m) {
    showDetailModalInner(m);
    if (getMsgReadStatus(m) !== 1) markMsgRead(id);
    return;
  }
  m = found(msgOutboxList);
  if (m) {
    showDetailModalInner(m);
    return;
  }
  // Fallback: fetch from server
  fetch(API + "/messages/inbox?userId=" + msgCurrentUserId).then(function(r) { return r.json(); }).then(function(d1) {
    msgInboxList = d1.data || [];
    var m1 = found(msgInboxList);
    if (m1) {
      showDetailModalInner(m1);
      if (getMsgReadStatus(m1) !== 1) markMsgRead(id);
      return;
    }
    fetch(API + "/messages/outbox?userId=" + msgCurrentUserId).then(function(r) { return r.json(); }).then(function(d2) {
      msgOutboxList = d2.data || [];
      var m2 = found(msgOutboxList);
      if (m2) showDetailModalInner(m2);
    });
  });
}

