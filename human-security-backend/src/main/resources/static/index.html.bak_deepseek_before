// Field compatibility helpers
function getUserName(u) {
  return u.realName || u.real_name || u.nickname || u.username || ('用户' + u.id);
}
function getMsgSenderName(m) {
  return m.senderName || m.sender_name || '-';
}
function getMsgReceiverName(m) {
  return m.receiverName || m.receiver_name || '-';
}
function getMsgReadStatus(m) {
  var rs = m.readStatus;
  if (rs != null) return rs;
  rs = m.read_status;
  if (rs != null) return rs;
  return 0;
}
function getMsgType(m) {
  return m.messageType || m.message_type || 'NORMAL';
}
function getMsgTime(m) {
  return m.createTime || m.create_time || '';
}

function loadMessages() {
  fetch(API + "/users/list").then(function(r) { return r.json(); }).then(function(d) {
    msgUsers = Array.isArray(d) ? d : (d && d.data ? d.data : []);
    var h = '';
    for (var i = 0; i < msgUsers.length; i++) {
      var u = msgUsers[i];
      h += '<option value="' + u.id + '">' + esc(getUserName(u)) + ' (' + (u.role || 'user') + ')</option>';
    }
    $("msgCurrentUser").innerHTML = h;
    $("msgReceiver").innerHTML = '';
    var saved = localStorage.getItem("security_current_user_id");
    var found = false;
    if (saved) {
      for (var i = 0; i < msgUsers.length; i++) {
        if (msgUsers[i].id == parseInt(saved)) { found = true; break; }
      }
    }
    if (found) {
      $("msgCurrentUser").value = saved;
    } else if (msgUsers.length > 0) {
      $("msgCurrentUser").value = msgUsers[0].id;
    }
    switchMsgUser();
  }).catch(function() { toast("用户列表加载失败", "err"); });
}

function switchMsgUser() {
  var vid = $("msgCurrentUser").value;
  msgCurrentUserId = vid ? parseInt(vid) : null;
  if (msgCurrentUserId) {
    localStorage.setItem("security_current_user_id", msgCurrentUserId);
    updateReceiverList();
    showMsgTab(msgCurrentBox);
    loadUnreadCount();
    refreshHomeUnread();
  } else {
    if (msgUsers.length === 0) {
      $("msgInboxTbody").innerHTML = '<tr class="empty"><td colspan="6">暂无系统用户，无法发送消息</td></tr>';
      $("msgOutboxTbody").innerHTML = '<tr class="empty"><td colspan="5">暂无系统用户，无法发送消息</td></tr>';
    } else {
      $("msgInboxTbody").innerHTML = '<tr class="empty"><td colspan="6">请选择当前用户</td></tr>';
      $("msgOutboxTbody").innerHTML = '<tr class="empty"><td colspan="5">请选择当前用户</td></tr>';
    }
    $("msgUnreadBadge").textContent = "0";
    $("hUnread").textContent = "0";
  }
}

function updateReceiverList() {
  var h = '';
  var hasOther = false;
  for (var i = 0; i < msgUsers.length; i++) {
    var u = msgUsers[i];
    if (u.id != msgCurrentUserId) {
      hasOther = true;
      h += '<option value="' + u.id + '">' + esc(getUserName(u)) + ' (' + (u.role || 'user') + ')</option>';
    }
  }
  $("msgReceiver").innerHTML = h || '<option value="">暂无其他可发送用户</option>';
