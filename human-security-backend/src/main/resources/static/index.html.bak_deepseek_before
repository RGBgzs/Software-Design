<script>
var API="http://localhost:8080/api";

// ==================== UTILS ====================
function $(id){return document.getElementById(id)}
function getList(r){if(!r)return[];if(Array.isArray(r))return r;if(r.data&&Array.isArray(r.data))return r.data;if(r.records&&Array.isArray(r.records))return r.records;return[]}
function esc(t){if(!t)return"";var d=document.createElement("div");d.appendChild(document.createTextNode(""+t));return d.innerHTML}
function ft(t){return t?(""+t).replace("T"," "):"-"}
function toast(m,t){var e=$("toast");e.textContent=m;e.className="toast toast-"+(t||"info")+" show";setTimeout(function(){e.className="toast"},2000)}
function closeModal(id){$(id).classList.remove("active")}
document.addEventListener("keydown", function(e){if(e.key==="Escape"){var modals=["kbModal","detailModal","contactModal"];for(var i=modals.length-1;i>=0;i--){if($(modals[i])&&$(modals[i]).classList.contains("active")){closeModal(modals[i]);e.preventDefault();break}}}});
function safeFetch(url, options){return fetch(url, options).then(function(r){if(!r.ok){throw new Error("HTTP "+r.status)}return r.json()})}

function showSection(name){
  document.querySelectorAll(".section").forEach(function(s){s.classList.remove("active")});
  document.querySelectorAll(".tabs button").forEach(function(b){b.classList.remove("active")});
  var sec = $("sec-"+name); if (!sec) { name = "home"; sec = $("sec-home"); } sec.classList.add("active");
	  var idx={home:0,chat:1,device:2,knowledge:3,alarm:4,help:5,message:6,history:7}[name]||0;
  var btns=document.querySelectorAll(".tabs button");if(btns[idx])btns[idx].classList.add("active");
  if(name==="home")loadDashboard();
  if(name==="device")loadDevices();
  if(name==="knowledge")loadKb();
  if(name==="alarm")loadAlarms();
	  if(name==="help")loadContacts();
	  if(name==="message")loadMessages();
  if(name==="history")loadChatHistory();
}

// ==================== HOME DASHBOARD ====================
var _dashFailCount=0; var _dashTotal=5;
function loadDashboard(){
	  fetch(API+"/device/status").then(function(r){return r.json()}).then(function(d){var list=getList(d);$("hDevices").textContent=list.length;var off=list.filter(function(dv){return dv.online===0});var db=$("deviceAlertBox"),dm=$("deviceAlertMsg");if(off.length>0){db.className="alert-box red";var names=off.map(function(dv){return dv.deviceName}).join("、");dm.innerHTML="<strong>⚠️ 存在离线设备</strong><br>请检查设备电源或网络："+names}else{db.className="alert-box";dm.innerHTML="<strong>✅ 设备运行正常</strong><br>所有设备在线。"}}).catch(function(){$("hDevices").textContent="--";_dashFailCount++});
  fetch(API+"/alarm/list").then(function(r){return r.json()}).then(function(d){var u=0;getList(d).forEach(function(a){if(a.alarmStatus==="UNHANDLED")u++});var el=$("hAlarms");el.textContent=u;if(u>0){el.style.color="#ea4335";el.style.fontWeight="800"}else{el.style.color="#1a73e8";el.style.fontWeight="700"}}).catch(function(){$("hAlarms").textContent="--";_dashFailCount++});
  fetch(API+"/kb/list").then(function(r){return r.json()}).then(function(d){$("hKb").textContent=getList(d).length}).catch(function(){$("hKb").textContent="--";_dashFailCount++});
  fetch(API+"/chat-record/list").then(function(r){return r.json()}).then(function(d){var t=new Date().toISOString().slice(0,10);var c=0;getList(d).forEach(function(r){if((r.createdAt||"").indexOf(t)===0)c++});$("hChats").textContent=c}).catch(function(){$("hChats").textContent="--";_dashFailCount++});
  if(msgCurrentUserId){fetch(API+"/messages/unread-count?userId="+msgCurrentUserId).then(function(r){return r.json()}).then(function(d){$("hUnread").textContent=d.count||0}).catch(function(){$("hUnread").textContent="0"})}
  fetch(API+"/alarm/latest").then(function(r){return r.json()}).then(function(d){var b=$("alertBox"),m=$("alertMsg");if(d&&d.hasAlarm&&d.data){b.className="alert-box red";m.innerHTML="<strong>⚠️ 存在未处理告警</strong><br>"+esc(d.data.alarmContent||d.data.alarmMessage||"")+"<br><small>请及时查看处理。</small>"}else{b.className="alert-box";m.innerHTML="<strong>✅ 系统运行正常</strong><br>当前暂无未处理告警。"}}).catch(function(){$("alertMsg").textContent="无法获取告警状态";_dashFailCount++});
  setTimeout(function(){if(_dashFailCount>=_dashTotal){toast("部分统计数据加载失败","err")}_dashFailCount=0;},2000);
}

function startDashboardTimer(){if(window._dashTimer)clearInterval(window._dashTimer);window._dashTimer=setInterval(loadDashboard,30000)}
function stopDashboardTimer(){if(window._dashTimer){clearInterval(window._dashTimer);window._dashTimer=null}}

// ==================== AI CHAT ====================
var lastAnswer="";
var SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
var rec=null,listening=false;
var alarmTimer=null,lastAlarmId=null;

function scrollChat(){var c=$("chatBox");requestAnimationFrame(function(){c.scrollTop=c.scrollHeight})}
function appendMsg(type,text,kid,cat,err){
  var d=document.createElement("div");d.className="msg "+type;
  var h='<div class="lbl">'+(type==="user"?"你":"🤖 智能助手")+'</div>';
  h+='<div class="b'+(err?'" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca':'')+'">'+esc(text)+'</div>';
  if(kid||cat){h+='<div class="m">';if(cat)h+='<span>📂 '+esc(cat)+'</span>';if(kid)h+='<span>🔗 ID:'+kid+'</span>';h+='</div>'}
  d.innerHTML=h;$("chatBox").appendChild(d);scrollChat();return d;
}
function appendTyping(){
  var d=document.createElement("div");d.className="msg bot";d.id="typing";
  d.innerHTML='<div class="lbl">🤖 智能助手 思考中...</div><div class="b"><div class="typing"><span></span><span></span><span></span></div></div>';
  $("chatBox").appendChild(d);scrollChat();return d;
}
function rmTyping(el){if(el&&el.parentNode)el.parentNode.removeChild(el)}
// ==================== AI 智能体回答渲染 ====================
var _intentNames={SECURITY_STATUS:"安防状态查询",DEVICE_QUERY:"设备状态查询",ALARM_QUERY:"告警信息查询",HELP_ADVICE:"求助建议",KNOWLEDGE_QA:"知识库问答",UNKNOWN:"通用问答"};
var _toolLabels={device_status:"设备状态",alarm_record:"告警记录",kb_knowledge:"知识库"};
var _riskLevels={LOW:"#16a34a",MEDIUM:"#f97316",HIGH:"#dc2626",CRITICAL:"#991b1b"};
var _riskBg={LOW:"#f0fdf4",MEDIUM:"#fff7ed",HIGH:"#fef2f2",CRITICAL:"#fef2f2"};
var _riskNames={LOW:"低风险",MEDIUM:"中风险",HIGH:"高风险",CRITICAL:"严重风险"};
function renderAgentMsg(data){
  var rl=data.riskLevel||"LOW";
  var color=_riskLevels[rl]||"#64748b";
  var bg=_riskBg[rl]||"#f8fafc";
  var d=document.createElement("div");d.className="msg bot";
  var h='';
  // header
  h+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">';
  h+='<span style="font-weight:700;color:#1e293b">🤖 AI 综合判断</span>';
  if(data.intent){h+='<span style="font-size:10px;color:#94a3b8">'+esc(_intentNames[data.intent]||data.intent)+'</span>';}
  h+='<span class="badge" style="background:'+color+';color:#fff;font-size:10px">'+esc(_riskNames[rl]||rl)+'</span>';
  if(data.source){h+='<span class="badge bg-gray" style="font-size:9px">来源：'+esc(data.source)+'</span>';}
  h+='</div>';
  // answer
  h+='<div style="background:'+bg+';border-radius:12px;padding:14px;margin-bottom:10px;border:1px solid '+color+';border-left:4px solid '+color+'">';
  h+='<div style="color:#1e293b;font-size:14px;line-height:1.7;white-space:pre-wrap">'+esc(data.answer||"")+'</div>';
  h+='</div>';
  // evidence
  if(data.evidence&&data.evidence.length>0){
    h+='<div style="margin-bottom:8px"><strong style="color:#1e293b;font-size:12px">📋 判断依据：</strong></div>';
    h+='<ul style="margin:4px 0 8px 18px;color:#475569;font-size:11px;line-height:1.8">';
    for(var i=0;i<data.evidence.length;i++){h+='<li>'+esc(data.evidence[i])+'</li>';}
    h+='</ul>';
  }
  // suggestions
  if(data.suggestions&&data.suggestions.length>0){
    h+='<div style="margin-bottom:8px"><strong style="color:#1e293b;font-size:12px">💡 建议操作：</strong></div>';
    h+='<ol style="margin:4px 0 8px 18px;color:#475569;font-size:11px;line-height:1.8">';
    for(var i=0;i<data.suggestions.length;i++){h+='<li>'+esc(data.suggestions[i])+'</li>';}
    h+='</ol>';
  }
  // usedTools
  if(data.usedTools&&data.usedTools.length>0){
    h+='<div style="margin-bottom:10px"><strong style="color:#1e293b;font-size:12px">🔧 使用数据：</strong> ';
    var tools=data.usedTools.map(function(t){return _toolLabels[t]||t;});
    h+='<span style="color:#64748b;font-size:11px">'+esc(tools.join("、"))+'</span></div>';
  }
  // actionDraft
  if(data.actionDraft&&data.actionDraft.type&&data.actionDraft.type!=="NONE"){
    h+='<div style="margin-top:10px;padding:10px 12px;background:#fffbeb;border-radius:10px;border:1px solid #fcd34d">';
    h+='<div style="font-size:11px;color:#92400e;margin-bottom:6px">📝 AI 已生成操作草稿，你可以选择：</div>';
    h+='<div style="display:flex;gap:6px;flex-wrap:wrap">';
    h+='<button class="btn btn-w btn-xs" onclick="fillHelpFromDraft(this)" data-type="'+esc(data.actionDraft.type)+'" data-title="'+esc(data.actionDraft.title||"")+'" data-content="'+esc(data.actionDraft.content||"").replace(/"/g,"&quot;")+'">🆘 带入紧急求助</button>';
    h+='<button class="btn btn-o btn-xs" onclick="fillMessageFromDraft(this)" data-type="'+esc(data.actionDraft.type)+'" data-title="'+esc(data.actionDraft.title||"")+'" data-content="'+esc(data.actionDraft.content||"").replace(/"/g,"&quot;")+'">📬 带入消息中心</button>';
    h+='</div></div>';
  }
  d.innerHTML=h;$("chatBox").appendChild(d);scrollChat();
}
function fillHelpFromDraft(el){
  var content=el.getAttribute("data-content")||"";
  var title=el.getAttribute("data-title")||"";
  $("helpContent").value=content;$("helpLevel").value="HIGH";
  if(typeof closeModal==="function")closeModal("detailModal");
  showSection("help");setTimeout(function(){generateHelpMsg();},300);
  toast("已根据 AI 建议生成求助信息","ok");
}
function fillMessageFromDraft(el){
  var content=el.getAttribute("data-content")||"";
  var title=el.getAttribute("data-title")||"";
  var type=el.getAttribute("data-type")||"HELP_MESSAGE";
  openMsgWithContent(title,content,type==="HELP_MESSAGE"?"HELP":type==="ALARM_MESSAGE"?"ALARM":"NORMAL");
  toast("已根据 AI 建议带入消息中心","ok");
}
